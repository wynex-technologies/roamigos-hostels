# Where the admin panel publishes the live offer popup.
#
# The endpoint must answer GET with JSON in the shape of `Offer` in
# src/data/offer.ts — every field is optional and merges over the defaults
# shipped in that file, so a payload can be as small as:
#
#   { "active": true, "image": "https://cdn.example.com/offers/monsoon.jpg", "code": "ROAM30" }
#
# `image` accepts either an Unsplash photo id or a full URL to an uploaded file.
# Leave this unset and the site renders the offer written in src/data/offer.ts.
VITE_OFFER_ENDPOINT=
