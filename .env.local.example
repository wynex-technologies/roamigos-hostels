# Local only. Gitignored, and it must stay that way.
#
# The service_role key bypasses every access rule in the database. It is read
# by the two scripts at build/seed time and never by the browser - which is why
# neither name is prefixed VITE_. On Vercel these are set as project
# environment variables instead of coming from a file.
SUPABASE_URL=https://sfolclcnfpxirlojembb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
